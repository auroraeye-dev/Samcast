# SwiftPM / build
.build/
.swiftpm/
DerivedData/
*.xcuserstate

# Release packaging output
build/
dist/

# Xcode project is generated from project.yml via XcodeGen; ignore the output
# so the human-readable spec is the source of truth. (Remove this line if you
# decide to commit the .xcodeproj instead.)
Samcast.xcodeproj/

# macOS
.DS_Store

# Misc
*.log

# The generated app icons ARE tracked, deliberately. They are produced by
# scripts/make-icons.swift from a single source image, but that source is not
# in the repo — so ignoring them would leave anyone who clones this unable to
# build an app with an icon, and unable to regenerate one.
#
# (The rule that used to sit here never worked anyway: a gitignore pattern
# containing a slash is anchored to the repo root, so "Assets.xcassets/**"
# never matched "App/Resources/Assets.xcassets/**".)
